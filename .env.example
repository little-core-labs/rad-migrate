# Copy to .env and fill in. .env is gitignored — never commit it.

# Required. Your Rad TV API key.
# Create one in your Rad account settings.
RAD_API_KEY=

# Optional. Rad API base URL. Only change this if you are pointing at a
# non-production environment.
# RAD_MIGRATE_API_URL=https://api.rad.live

# Optional. Destination channel. If unset, rad-migrate uses the channel your
# API key resolves to, or creates one named after the source channel.
# RAD_MIGRATE_CHANNEL=

# Optional. Where downloads and resume state live. Defaults to ./rad-migrate-work
# RAD_MIGRATE_WORKDIR=

# Optional. Browser to pull YouTube cookies from: chrome | firefox | edge |
# brave | chromium | opera | vivaldi | safari
# Cookies are only needed for HD on some networks. rad-migrate probes first and
# tells you if it needs them.
# RAD_MIGRATE_COOKIES_FROM_BROWSER=chrome

# Optional. Path to a Netscape-format cookies.txt. Use this instead of
# COOKIES_FROM_BROWSER in Docker, where browser extraction cannot work.
# RAD_MIGRATE_COOKIES_FILE=
